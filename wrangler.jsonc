{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pitacco",
  "main": "./cloudflare/storefront.mjs",
  "compatibility_date": "2026-11-10",
  "previews": {},
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "PITACCO_SUPABASE_URL": "https://mdevzehqcpcgxspwbiyz.supabase.co",
    "PITACCO_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_JLIp1y5II26GrztrKDNIyQ_ryETrCuj"
  },
  "ratelimits": [
    {
      "name": "SALES_COACH_LIMIT",
      "namespace_id": "250820",
      "simple": {
        "limit": 4,
        "period": 60
      }
    }
  ]
}
