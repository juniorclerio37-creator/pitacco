{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pitacco",
  "main": "./cloudflare/storefront.mjs",
  "compatibility_date": "2026-11-10",
  "previews": {},
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
