{
  "name": "pitacco/core",
  "description": "Pitacco Core API - isolated migration foundation",
  "type": "project",
  "require": {
    "php": "^8.4",
    "laravel/framework": "^13.0",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "ext-redis": "*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "allow-plugins": {}
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
